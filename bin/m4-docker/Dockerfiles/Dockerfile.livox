ARG BASE_IMAGE=ros:humble-ros-base

FROM ${BASE_IMAGE}
SHELL ["/bin/bash","-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# Dev + build deps
RUN apt-get update && apt-get install --no-install-recommends -y \
    nano wget curl tmux git ca-certificates \
    build-essential python3-pip python3-setuptools \
    python3-colcon-common-extensions python3-rosdep python3-vcstool \
  && rm -rf /var/lib/apt/lists/*

# ROS Packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rosbag2-storage-mcap \
    ros-humble-foxglove-bridge \
    libeigen3-dev \
    ros-humble-ament-cmake-auto \
    libpcl-dev \
    ros-humble-pcl-conversions \ 
  && rm -rf /var/lib/apt/lists/*

# pip basics
RUN pip3 install --no-cache-dir --upgrade pip setuptools==70.3.0 wheel

# rosdep
RUN rosdep init || true && rosdep update

# Install Livox SDK2
WORKDIR /opt
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git && \
    cd Livox-SDK2 && mkdir build && cd build && \
    cmake .. && make -j$(nproc) && make install \
    && rm -rf Livox-SDK2

# Livox ROS 2 driver workspace (supports MID360 via Livox-SDK2)
WORKDIR /opt/livox_ws
RUN mkdir -p src && cd src && \
    git clone --depth=1 https://github.com/Livox-SDK/livox_ros_driver2.git
# Resolve dependencies and build livox ROS 2 driver
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && \
    rosdep install -i --from-path src --rosdistro ${ROS_DISTRO} -y && \
    # Copy ROS2 launch files to main launch directory, build, cleanup.
    cd src/livox_ros_driver2 && \
    cp package_ROS2.xml package.xml && cp -r launch_ROS2 launch && cd ../../ && \
    colcon build --cmake-args -DROS_EDITION=ROS2 -DHUMBLE_ROS=humble -DCMAKE_BUILD_TYPE=Release && \
    rm -rf src/livox_ros_driver2/launch

# Environment
WORKDIR /home/num4
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc && \
    echo "source /opt/livox_ws/install/setup.bash" >> /etc/bash.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> /etc/bash.bashrc && \
    echo "export PS1='\\[\\e[1;35m\\]\\u@\\h:\\[\\e[1;34m\\]\\w\\[\\e[0m\\]\\$ '" >> /etc/bash.bashrc

ENTRYPOINT ["bash"]
