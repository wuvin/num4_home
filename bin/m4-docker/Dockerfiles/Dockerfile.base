ARG BASE_IMAGE=ros:humble-ros-base

FROM ${BASE_IMAGE}
SHELL ["/bin/bash","-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# Refresh ROS 2 apt key (one in base image may have expired, EXPKEYSIG error)
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg

# Common tools
RUN apt-get update && apt-get install --no-install-recommends -y \
    nano wget curl tmux git ca-certificates \
    build-essential python3-pip python3-setuptools \
    python3-colcon-common-extensions python3-rosdep python3-vcstool \
  && rm -rf /var/lib/apt/lists/*

# ROS Packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rosbag2-storage-mcap \
    ros-humble-foxglove-bridge \
    libeigen3-dev \
  && rm -rf /var/lib/apt/lists/*

# pip basics (use PyPI as fallback in case of TLS issue)
RUN pip3 config set global.extra-index-url https://pypi.org/simple
RUN pip3 install --no-cache-dir --upgrade pip setuptools==70.3.0 wheel

# rosdep
RUN rosdep init || true && rosdep update

# shell defaults
WORKDIR /home/num4
RUN echo "export ROS_DOMAIN_ID=11" >> ~/.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> ~/.bashrc && \
    echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "export PS1='\\[\\e[1;35m\\]\\u@\\h:\\[\\e[1;34m\\]\\w\\[\\e[0m\\]\\$ '" >> ~/.bashrc

ENTRYPOINT ["bash"]
