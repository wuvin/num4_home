ARG BASE_IMAGE=ros:humble-ros-base

FROM ${BASE_IMAGE}
SHELL ["/bin/bash","-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# Common dev + ROS build tools
RUN apt-get update && apt-get install --no-install-recommends -y \
    git curl ca-certificates \
    build-essential cmake pkg-config \
    python3-pip python3-setuptools python3-colcon-common-extensions \
    python3-rosdep python3-vcstool udev \
  && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --upgrade pip setuptools==70.3.0 wheel
RUN rosdep init || true && rosdep update

# librealsense from script 
COPY libuvc_installation.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/libuvc_installation.sh && /usr/local/bin/libuvc_installation.sh

# realsense-ros workspace
WORKDIR /opt/realsense_ws
RUN mkdir -p src && cd src && git clone -b 4.55.1 https://github.com/IntelRealSense/realsense-ros.git
RUN apt-get update && \
    rosdep install -i --from-path src --rosdistro ${ROS_DISTRO} \
    --skip-keys="librealsense2 cv_bridge libopencv-dev libopencv-contrib-dev libopencv-imgproc-dev python3-opencv opencv2" -y && \
    rm -rf /var/lib/apt/lists/*
#RUN . /opt/ros/${ROS_DISTRO}/setup.sh && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# Build cv_bridge from source against existing dustynv OpenCV 4.8.1
RUN cd /opt/realsense_ws/src && \
    git clone -b humble https://github.com/ros-perception/vision_opencv.git

# Build altogether cv_bridge + realsense-ros
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# Environment
WORKDIR /home/num4
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "source /opt/realsense_ws/install/local_setup.bash" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=9" >> ~/.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> ~/.bashrc && \
    echo "export PS1='\\[\\e[1;35m\\]\\u@\\h:\\[\\e[1;34m\\]\\w\\[\\e[0m\\]\\$ '" >> ~/.bashrc

ENTRYPOINT ["bash"]
